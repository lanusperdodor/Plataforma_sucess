{
  "expo": {
    "name": "Fluentia",
    "slug": "fluentia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fluentia",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C11",
    "android": {
      "package": "com.fluentia.pessoal",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C0C11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Fluentia usa o microfone para ouvir sua pronúncia e conversar com o professor.",
          "speechRecognitionPermission": "O Fluentia usa o reconhecimento de fala para transcrever o que você diz.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Fluentia usa o microfone para ouvir sua pronúncia e conversar com o professor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
